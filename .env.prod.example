# Docker image
IMAGE_REPOSITORY=asia-northeast3-docker.pkg.dev/your-gcp-project/ecommerce/backend
IMAGE_TAG=replace-with-commit-sha
BACKEND_PORT=8080

# MySQL
MYSQL_DATABASE=ecommerce
MYSQL_USER=ecommerce_app
MYSQL_PASSWORD=replace-with-mysql-password
MYSQL_ROOT_PASSWORD=replace-with-mysql-root-password

# Redis
REDIS_PASSWORD=replace-with-redis-password

# JWT
JWT_SECRET=replace-with-at-least-32-byte-random-secret

# Toss Payments
TOSS_SECRET_KEY=replace-with-toss-secret-key
TOSS_SECURITY_KEY=replace-with-toss-security-key

# AWS S3
AWS_ACCESS_KEY_ID=replace-with-aws-access-key
AWS_SECRET_ACCESS_KEY=replace-with-aws-secret-key
AWS_REGION=ap-northeast-2
AWS_S3_BUCKET=replace-with-s3-bucket
AWS_S3_PUBLIC_BASE_URL=

# Frontend
CORS_ALLOWED_ORIGINS=https://example.com
